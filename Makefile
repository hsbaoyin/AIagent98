# AIagent98 - OpenWatcom wmake build for 32-bit Windows 9x/NT.
#
# Prerequisites:
#   * OpenWatcom 2.0 extracted to tools\openwatcom\ow
#   * The location is picked up from (first match wins):
#       1. WATCOM_ROOT, 2. WATCOM, 3. the bundled tools\openwatcom\ow copy
#     (build_ow.cmd sets both variables)
#
# Usage:
#   build_ow.cmd            (recommended; sets up the environment)
#   wmake -f Makefile       (if the environment is already configured)
#
# ow\rules.mk and the link response files are generated by
# tools\gen_ow_build.ps1.  Re-run that script after adding or removing
# source files.

!ifndef WATCOM_ROOT
!ifdef WATCOM
WATCOM_ROOT = $(WATCOM)
!else
WATCOM_ROOT = tools\openwatcom\ow
!endif
!endif
CC   = $(WATCOM_ROOT)\binnt\wcl386.exe
LINK = $(WATCOM_ROOT)\binnt\wlink.exe
RC   = $(WATCOM_ROOT)\binnt\wrc.exe

all: makeobjdir build\ow\a98.exe build\ow\agent98.exe .SYMBOLIC

# The object directories used to be created only by build_ow.cmd, so a clean
# tree with the environment already configured failed on the first wmake,
# and "clean" (which deletes build\ow\obj) made it fail again afterwards.
makeobjdir: .SYMBOLIC
	-@cmd /c if not exist build\ow\obj mkdir build\ow\obj
	-@cmd /c if not exist build\ow\obj\bearssl mkdir build\ow\obj\bearssl

!include ow\rules.mk

build\ow\a98.exe: $(OBJS)
	$(LINK) @ow\link.rsp

build\ow\gui.res: src\gui\gui.rc src\gui\resource.h
	$(RC) -q -bt=nt -r -zm -fo=$@ src\gui\gui.rc

build\ow\agent98.exe: $(GUI_OBJS) build\ow\gui.res
	$(LINK) @ow\link_gui.rsp

gui: makeobjdir build\ow\agent98.exe .SYMBOLIC

probe: makeobjdir build\ow\tlsprobe.exe .SYMBOLIC

build\ow\tlsprobe.exe: $(PROBE_OBJS)
	$(LINK) @ow\link_tlsprobe.rsp

clean: .SYMBOLIC
	-@cmd /c if exist build\ow\obj rmdir /s /q build\ow\obj
	-@if exist build\ow\a98.exe del build\ow\a98.exe
	-@if exist build\ow\a98.map del build\ow\a98.map
	-@if exist build\ow\agent98.exe del build\ow\agent98.exe
	-@if exist build\ow\agent98.map del build\ow\agent98.map
	-@if exist build\ow\gui.res del build\ow\gui.res
	-@if exist build\ow\tlsprobe.exe del build\ow\tlsprobe.exe
	-@if exist build\ow\tlsprobe.map del build\ow\tlsprobe.map
# agent98.ini is user configuration, not a build artifact: keep it across
# `clean` so a clean release rebuild does not reset the operator's settings.
