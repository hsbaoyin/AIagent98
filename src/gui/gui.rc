/*
 * AIagent98 - Win32 resources.
 *
 * Kept deliberately simple so that wrc (OpenWatcom) and windres (MinGW)
 * both accept the file.
 */
#include <windows.h>
#include "resource.h"

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New conversation",        IDM_NEW
        MENUITEM "Resend last message",      IDM_RESEND
        MENUITEM SEPARATOR
        MENUITEM "&Save session...",         IDM_SAVE
        MENUITEM "&Load session...",         IDM_LOAD
        MENUITEM "&Rename current session...", IDM_SESSION_RENAME
        MENUITEM "De&lete current session...", IDM_SESSION_DELETE
        MENUITEM "&Export transcript...",    IDM_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                    IDM_EXIT
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Insert &emoji...",         IDM_EMOJI
        MENUITEM "&Open workspace",          IDM_WORKSPACE
        MENUITEM "&Settings...",             IDM_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "&Tools & skills...",      IDM_TOOLS_LIST
        MENUITEM "Open &log file",           IDM_OPENLOG
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About AIagent98",           IDM_ABOUT
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    VK_ESCAPE, IDC_STOP, VIRTKEY
    "N", IDM_NEW, VIRTKEY, CONTROL
    "R", IDM_RESEND, VIRTKEY, CONTROL
    "S", IDM_SAVE, VIRTKEY, CONTROL
    "O", IDM_LOAD, VIRTKEY, CONTROL
    "E", IDM_EXPORT, VIRTKEY, CONTROL
    "J", IDM_EMOJI, VIRTKEY, CONTROL
END

IDD_SETTINGS DIALOG 0, 0, 360, 300
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AIagent98 Settings"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "", IDC_SETTINGS_TAB, "SysTabControl32", WS_TABSTOP | TCS_TABS, 8, 8, 344, 252

    /* --- Page 0: API & model --- */
    LTEXT           "Provider:", IDC_L_PROVIDER, 16, 30, 60, 8
    COMBOBOX        IDC_PROVIDER, 80, 27, 150, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "A preset fills in the API base and model.", IDC_L_PRESET, 16, 42, 320, 8
    LTEXT           "API base:", IDC_L_API_BASE, 16, 56, 60, 8
    EDITTEXT        IDC_API_BASE, 80, 53, 264, 12, ES_AUTOHSCROLL
    LTEXT           "API key:", IDC_L_API_KEY, 16, 72, 60, 8
    EDITTEXT        IDC_API_KEY, 80, 69, 264, 12, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "Model:", IDC_L_MODEL, 16, 88, 60, 8
    EDITTEXT        IDC_MODEL, 80, 85, 264, 12, ES_AUTOHSCROLL
    LTEXT           "System prompt:", IDC_L_PROMPT, 16, 104, 60, 8
    EDITTEXT        IDC_SYSTEM_PROMPT, 80, 101, 264, 44, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Temperature:", IDC_L_TEMP, 16, 152, 60, 8
    EDITTEXT        IDC_TEMPERATURE, 80, 149, 48, 12, ES_AUTOHSCROLL
    LTEXT           "Max tokens:", IDC_L_MAXTOK, 140, 152, 54, 8
    EDITTEXT        IDC_MAX_TOKENS, 196, 149, 48, 12, ES_AUTOHSCROLL
    LTEXT           "Max steps (0=inf):", IDC_L_MAXSTEP, 254, 152, 70, 8
    EDITTEXT        IDC_MAX_STEPS, 326, 149, 30, 12, ES_AUTOHSCROLL
    LTEXT           "Extra headers:", IDC_L_HEADERS, 16, 168, 60, 8
    EDITTEXT        IDC_EXTRA_HEADERS, 80, 165, 264, 26, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    CONTROL         "Stream responses (SSE)", IDC_STREAM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 196, 140, 10
    PUSHBUTTON      "Test connection", IDC_TEST, 80, 214, 80, 14
    LTEXT           "", IDC_TEST_RESULT, 168, 212, 176, 30

    /* --- Page 1: Agent --- */
    LTEXT           "Workspace:", IDC_L_WORKSPACE, 16, 30, 60, 8
    EDITTEXT        IDC_WORKSPACE, 80, 27, 264, 12, ES_AUTOHSCROLL
    CONTROL         "Allow shell commands (COMMAND.COM)", IDC_ALLOW_SHELL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 48, 260, 10
    CONTROL         "Allow paths outside the workspace", IDC_ALLOW_OUTSIDE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 62, 260, 10
    CONTROL         "Verify TLS certificates", IDC_TLS_VERIFY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 76, 260, 10
    CONTROL         "Draw emoji as inline pictures", IDC_EMOJI_INLINE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 90, 260, 10
    LTEXT           "Connect timeout (s):", IDC_L_CONNTO, 16, 112, 80, 8
    EDITTEXT        IDC_CONNECT_TIMEOUT, 100, 109, 50, 12, ES_AUTOHSCROLL
    LTEXT           "Request timeout (s):", IDC_L_REQTO, 166, 112, 80, 8
    EDITTEXT        IDC_REQUEST_TIMEOUT, 250, 109, 50, 12, ES_AUTOHSCROLL
    LTEXT           "Log level (0=ERROR .. 4=TRACE):", IDC_L_LOG, 16, 132, 120, 8
    EDITTEXT        IDC_LOG_LEVEL, 140, 129, 40, 12, ES_AUTOHSCROLL
    LTEXT           "Compact context at (bytes, 0=off):", IDC_L_COMPACT_TH, 16, 150, 120, 8
    EDITTEXT        IDC_COMPACT_THRESHOLD, 140, 147, 70, 12, ES_AUTOHSCROLL
    LTEXT           "Keep recent messages:", IDC_L_COMPACT_KEEP, 220, 150, 90, 8
    EDITTEXT        IDC_COMPACT_KEEP, 312, 147, 30, 12, ES_AUTOHSCROLL
    CONTROL         "DANGER: full system access (no sandbox, all commands)", IDC_FULL_ACCESS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 164, 264, 10
    CONTROL         "DANGER: auto-confirm all tools (never ask)", IDC_AUTO_CONFIRM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 172, 264, 10
    LTEXT           "Tool profile:", IDC_L_TOOL_PROFILE, 16, 186, 80, 8
    EDITTEXT        IDC_TOOL_PROFILE, 100, 183, 120, 12, ES_AUTOHSCROLL
    CONTROL         "Recover tool calls from plain-text replies", IDC_TOOL_CALL_FALLBACK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 198, 264, 10
    CONTROL         "Skip unchanged file re-reads", IDC_READ_CACHE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 208, 264, 10
    CONTROL         "Hint the model to finish after passing checks", IDC_NUDGE_ON_SUCCESS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 218, 264, 10
    LTEXT           "Full access removes the sandbox and the command ban list.", IDC_L_WARN1, 16, 232, 320, 8
    LTEXT           "Both dangerous options are intended for disposable VMs only.", IDC_L_WARN2, 16, 242, 320, 8

    /* --- Page 2: Network --- */
    CONTROL         "Enable network tools", IDC_NET_ALLOW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 30, 260, 10
    LTEXT           "Allow hosts:", IDC_L_HOSTS, 16, 52, 80, 8
    EDITTEXT        IDC_NET_ALLOW_HOSTS, 100, 49, 244, 12, ES_AUTOHSCROLL
    LTEXT           "Max response bytes:", IDC_L_MAXBYTES, 16, 72, 80, 8
    EDITTEXT        IDC_NET_MAX_BYTES, 100, 69, 90, 12, ES_AUTOHSCROLL
    LTEXT           "Search URL (%s = query):", IDC_L_SEARCHURL, 16, 92, 100, 8
    EDITTEXT        IDC_NET_SEARCH_URL, 100, 89, 244, 12, ES_AUTOHSCROLL
    LTEXT           "GitHub token (gist):", IDC_L_TOKEN, 16, 112, 80, 8
    EDITTEXT        IDC_NET_GITHUB_TOKEN, 100, 109, 244, 12, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "Network tools are OFF unless 'Enable network tools' is checked.", IDC_L_NET1, 16, 138, 320, 8
    LTEXT           "allow_hosts is comma-separated; '.domain' matches a suffix.", IDC_L_NET2, 16, 150, 320, 8
    LTEXT           "Empty allow_hosts allows any host. github_token needs gist scope.", IDC_L_NET3, 16, 162, 320, 8

    DEFPUSHBUTTON   "OK", IDOK, 240, 276, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 296, 276, 50, 14
END

IDD_CONFIRM DIALOG 0, 0, 320, 210
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AIagent98 - Confirm tool call"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "The model wants to use this tool:", -1, 8, 8, 300, 8
    LTEXT           "", IDC_CONFIRM_TOOL, 8, 22, 300, 8
    EDITTEXT        IDC_CONFIRM_ARGS, 8, 36, 304, 132, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "Allow", IDOK, 196, 182, 54, 14
    PUSHBUTTON      "Deny", IDCANCEL, 258, 182, 54, 14
END

IDD_TOOLS DIALOG 0, 0, 420, 300
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AIagent98 - Tools & Skills"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Built-in tools:", -1, 8, 8, 130, 8
    LISTBOX         IDC_TOOLS_LIST, 8, 18, 130, 100, LBS_STANDARD | WS_TABSTOP
    LTEXT           "Skills (procedural memory):", -1, 146, 8, 180, 8
    LISTBOX         IDC_SKILLS_LIST, 146, 18, 180, 100, LBS_STANDARD | WS_TABSTOP
    PUSHBUTTON      "New...", IDC_SKILL_NEW, 334, 26, 78, 14
    PUSHBUTTON      "Edit...", IDC_SKILL_EDIT, 334, 44, 78, 14
    PUSHBUTTON      "Delete", IDC_SKILL_DELETE, 334, 62, 78, 14
    LTEXT           "Details:", -1, 8, 126, 300, 8
    EDITTEXT        IDC_TOOLS_DETAIL, 8, 136, 404, 134, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "Close", IDOK, 348, 278, 64, 14
END

IDD_SKILL_EDIT DIALOG 0, 0, 400, 280
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AIagent98 - Skill"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Name:", -1, 8, 10, 50, 8
    EDITTEXT        IDC_SKILL_NAME, 62, 7, 320, 12, ES_AUTOHSCROLL
    LTEXT           "Description:", -1, 8, 28, 60, 8
    EDITTEXT        IDC_SKILL_DESC, 62, 25, 320, 12, ES_AUTOHSCROLL
    LTEXT           "Instructions (Markdown):", -1, 8, 46, 160, 8
    EDITTEXT        IDC_SKILL_CONTENT, 8, 56, 384, 190, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    DEFPUSHBUTTON   "Save", IDOK, 266, 256, 60, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 332, 256, 60, 14
END

IDD_ABOUT DIALOG 0, 0, 240, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About AIagent98"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "AIagent98", IDC_ABOUT_VERSION, 12, 10, 216, 10
    LTEXT           "An AI agent for Windows 98 / 95 / ME.", -1, 12, 28, 216, 10
    LTEXT           "Native Win32, BearSSL TLS 1.2.", -1, 12, 44, 216, 10
    LTEXT           "", IDC_ABOUT_BUILD, 12, 60, 216, 10
    DEFPUSHBUTTON   "OK", IDOK, 182, 96, 50, 14
END

IDD_FIRSTRUN DIALOG 0, 0, 320, 176
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Welcome to AIagent98"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Connect to an OpenAI-compatible API. You can change all of this later in Tools > Settings.", -1, 8, 6, 300, 18
    LTEXT           "Provider:", IDC_L_PROVIDER, 8, 30, 58, 8
    COMBOBOX        IDC_PROVIDER, 72, 27, 130, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "API base:", IDC_L_API_BASE, 8, 46, 58, 8
    EDITTEXT        IDC_API_BASE, 72, 43, 240, 12, ES_AUTOHSCROLL
    LTEXT           "API key:", IDC_L_API_KEY, 8, 62, 58, 8
    EDITTEXT        IDC_API_KEY, 72, 59, 240, 12, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "Model:", IDC_L_MODEL, 8, 78, 58, 8
    EDITTEXT        IDC_MODEL, 72, 75, 240, 12, ES_AUTOHSCROLL
    LTEXT           "A local service such as Ollama does not need an API key.", -1, 72, 90, 240, 8
    CONTROL         "Stream responses", IDC_STREAM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 72, 104, 120, 10
    CONTROL         "Allow shell commands (every run asks for confirmation)", IDC_ALLOW_SHELL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 72, 117, 240, 10
    DEFPUSHBUTTON   "Save", IDOK, 204, 150, 54, 14
    PUSHBUTTON      "Later", IDCANCEL, 262, 150, 50, 14
END

IDD_INPUTLINE DIALOG 0, 0, 300, 64
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AIagent98"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "", IDC_INPUTLINE_LABEL, 8, 8, 284, 8
    EDITTEXT        IDC_INPUTLINE_EDIT, 8, 22, 284, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 186, 44, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 242, 44, 50, 14
END

/* Win9x has no emoji font, so the picker shows the pack's BMP artwork and
 * hands the input line a ":shortcode:" instead of a character it cannot
 * display.  SysListView32 is a common control (comctl32 4.70+). */
IDD_EMOJI DIALOG 0, 0, 344, 250
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Insert emoji"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Filter:", -1, 8, 9, 24, 8
    EDITTEXT        IDC_EMOJI_FILTER, 34, 7, 100, 12, ES_AUTOHSCROLL
    LTEXT           "", IDC_EMOJI_HINT, 140, 9, 196, 16
    CONTROL         "", IDC_EMOJI_LIST, "SysListView32", LVS_ICON | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP | WS_VSCROLL, 8, 28, 328, 192
    DEFPUSHBUTTON   "Insert", IDOK, 226, 228, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 284, 228, 52, 14
END

